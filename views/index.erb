<div class="explorer-toolbar">
  <form id="search-form" class="search-form" autocomplete="off">
    <div class="input-group input-group-sm">
      <span class="input-group-text"><i class="bi bi-search"></i></span>
      <input id="search-q" class="form-control" type="search" placeholder="Search payloads…" aria-label="Search payloads">
      <button class="btn btn-outline-secondary" type="submit">Search</button>
    </div>
    <div class="form-check form-check-inline small mb-0 text-nowrap">
      <input class="form-check-input" type="checkbox" id="search-scope">
      <label class="form-check-label" for="search-scope">this topic only</label>
    </div>
  </form>
  <div class="toolbar-controls">
    <select id="range" class="form-select form-select-sm range-select" aria-label="Time range">
      <option value="15m">Last 15 min</option>
      <option value="1h">Last hour</option>
      <option value="6h">Last 6 hours</option>
      <option value="24h">Last 24 hours</option>
      <option value="7d">Last 7 days</option>
      <option value="custom">Custom…</option>
    </select>
    <div id="custom-range" class="custom-range d-none">
      <input id="range-from" type="datetime-local" class="form-control form-control-sm" aria-label="From">
      <span class="text-muted">→</span>
      <input id="range-to" type="datetime-local" class="form-control form-control-sm" aria-label="To">
      <button id="range-apply" class="btn btn-sm btn-outline-secondary" type="button">Apply</button>
    </div>
    <button id="pause-btn" class="btn btn-sm btn-outline-secondary" type="button" title="Pause live updates">
      <i class="bi bi-pause-fill"></i><span class="ms-1">Pause</span>
    </button>
    <button id="publish-btn" class="btn btn-sm btn-primary d-none" type="button" title="Publish a message">
      <i class="bi bi-send me-1"></i>Publish
    </button>
  </div>
</div>

<div class="explorer">
  <section class="pane pane-tree" aria-label="Topics">
    <div class="pane-head">
      <div class="input-group input-group-sm">
        <span class="input-group-text"><i class="bi bi-funnel"></i></span>
        <input id="topic-filter" data-hotkey="/" class="form-control" type="search" placeholder="Filter topics: text or glob (+ # *)" aria-label="Filter topics">
      </div>
      <button id="tree-collapse" class="btn btn-sm btn-icon" type="button" title="Collapse all"><i class="bi bi-arrows-collapse"></i></button>
    </div>
    <div class="pane-sub"><span id="topic-count">Loading topics…</span></div>
    <div id="tree" class="pane-body tree-body"></div>
  </section>

  <section class="pane pane-timeline" aria-label="Timeline">
    <div class="pane-head pane-head-stack">
      <div id="tl-title" class="pane-title text-muted">No topic selected</div>
      <div id="tl-meta" class="pane-meta"></div>
    </div>
    <div id="timeline" class="pane-body timeline-body"></div>
    <div class="pane-foot">
      <span id="tl-status" class="small text-muted"></span>
      <button id="load-more" class="btn btn-sm btn-outline-secondary d-none" type="button"><i class="bi bi-chevron-double-down me-1"></i>Load more</button>
    </div>
  </section>

  <section class="pane pane-detail" aria-label="Message detail">
    <div class="pane-head">
      <div class="pane-tabs" role="tablist">
        <button class="pane-tab active" type="button" data-tab="payload"><i class="bi bi-braces me-1"></i>Payload</button>
        <button class="pane-tab" type="button" data-tab="diff"><i class="bi bi-file-diff me-1"></i>Diff</button>
        <button class="pane-tab" type="button" data-tab="chart"><i class="bi bi-graph-up me-1"></i>Chart</button>
      </div>
      <button id="copy-btn" class="btn btn-sm btn-icon ms-auto d-none" type="button" title="Copy payload"><i class="bi bi-clipboard"></i></button>
    </div>
    <div id="detail-meta" class="detail-meta d-none"></div>
    <div id="tab-payload" class="pane-body detail-body"></div>
    <div id="tab-diff" class="pane-body detail-body d-none"></div>
    <div id="tab-chart" class="pane-body detail-body d-none">
      <div class="chart-controls">
        <select id="chart-path" class="form-select form-select-sm" aria-label="Numeric path"></select>
        <button id="chart-reload" class="btn btn-sm btn-icon" type="button" title="Reload series"><i class="bi bi-arrow-clockwise"></i></button>
      </div>
      <div id="chart-empty" class="d-none"></div>
      <div id="chart-box" class="chart-box"></div>
    </div>
  </section>
</div>

<div class="modal fade" id="publish-modal" tabindex="-1" aria-labelledby="publish-title" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-lg">
    <form class="modal-content" id="publish-form" autocomplete="off">
      <div class="modal-header">
        <h5 class="modal-title" id="publish-title"><i class="bi bi-send me-2"></i>Publish a message</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <div class="mb-3">
          <label class="form-label" for="pub-topic">Topic</label>
          <input id="pub-topic" class="form-control font-monospace" type="text" required placeholder="home/livingroom/lamp/set">
          <div class="form-text">No wildcards (<code>+</code>, <code>#</code>).</div>
        </div>
        <div class="mb-3">
          <label class="form-label" for="pub-payload">Payload</label>
          <textarea id="pub-payload" class="form-control font-monospace auto-rows" rows="6" placeholder='{"on": true}'></textarea>
          <div id="pub-hint" class="form-text"></div>
        </div>
        <div class="d-flex flex-wrap align-items-center gap-4">
          <div class="form-check form-switch mb-0">
            <input class="form-check-input" type="checkbox" id="pub-retain">
            <label class="form-check-label" for="pub-retain">Retain</label>
          </div>
          <div class="d-flex align-items-center gap-2">
            <label class="form-label mb-0" for="pub-qos">QoS</label>
            <select id="pub-qos" class="form-select form-select-sm qos-select">
              <option value="0">0 · at most once</option>
              <option value="1">1 · at least once</option>
              <option value="2">2 · exactly once</option>
            </select>
          </div>
        </div>
      </div>
      <div class="modal-footer">
        <span id="pub-confirm-text" class="me-auto small text-warning d-none"></span>
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" id="pub-submit" class="btn btn-primary"><i class="bi bi-send me-1"></i>Publish</button>
      </div>
    </form>
  </div>
</div>

<div class="modal fade" id="search-modal" tabindex="-1" aria-labelledby="search-title" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable modal-xl">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="search-title"><i class="bi bi-search me-2"></i>Search results</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body p-0">
        <div id="search-summary" class="search-summary"></div>
        <div id="search-results" class="search-results"></div>
      </div>
    </div>
  </div>
</div>
