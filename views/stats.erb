<header class="t-page-header">
  <h1 class="t-page-title"><svg class="t-icon" aria-hidden="true"><use href="/tailor/icons.svg#bi-speedometer2"/></svg>Stats</h1>
  <div class="t-page-actions"><span id="stats-updated" class="t-small t-muted"></span></div>
</header>

<div class="t-grid stats-grid" data-min="md">
  <div class="t-card">
    <div class="t-card-header">
      <h3 class="t-card-title"><svg class="t-icon" aria-hidden="true"><use href="/tailor/icons.svg#bi-box-arrow-in-down"/></svg>Ingest</h3>
      <span id="ingest-badge" class="t-card-tools"></span>
    </div>
    <div class="t-card-body">
      <dl id="ingest-kv" class="kv"></dl>
    </div>
  </div>

  <div class="t-card">
    <div class="t-card-header">
      <h3 class="t-card-title"><svg class="t-icon" aria-hidden="true"><use href="/tailor/icons.svg#bi-database"/></svg>Database</h3>
      <span class="t-card-tools">
        <span id="db-governing"></span>
        <button id="prune-btn" class="t-btn" data-size="sm" data-tone="warning" type="button"><svg class="t-icon" aria-hidden="true"><use href="/tailor/icons.svg#bi-scissors"/></svg>Prune now</button>
      </span>
    </div>
    <div class="t-card-body">
      <div class="stat-row">
        <span id="db-size-label" class="t-stat-value">—</span>
        <span id="db-size-pct" class="t-stat-sub"></span>
      </div>
      <div class="t-progress db-progress" data-size="sm" role="progressbar" aria-label="Database size" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0">
        <div id="db-size-bar" class="t-progress-bar" style="--t-value: 0%"></div>
      </div>
      <dl id="db-kv" class="kv"></dl>
    </div>
  </div>
</div>

<section class="t-section">
  <h2 class="t-section-title">Broker <span class="t-muted section-title-sub">$SYS</span></h2>
  <div id="sys-empty" hidden></div>
  <div id="sys-groups" class="t-grid stats-grid" data-min="sm"></div>
</section>

<section id="sparks-section" class="t-section">
  <h2 class="t-section-title">Last 24 hours</h2>
  <div id="sparks" class="t-grid spark-grid" data-min="sm"></div>
</section>

<details id="sys-all-card" class="t-card t-section" data-variant="collapsible">
  <summary class="t-card-header">
    <h3 class="t-card-title"><svg class="t-icon" aria-hidden="true"><use href="/tailor/icons.svg#bi-list-ul"/></svg>All $SYS topics</h3>
    <span id="sys-all-count" class="t-card-tools t-small t-muted"></span>
  </summary>
  <div id="sys-all" class="t-table-wrap">
    <table class="t-table" data-variant="data" data-density="compact">
      <thead><tr><th>Topic</th><th class="t-col-num">Value</th></tr></thead>
      <tbody id="sys-all-body"></tbody>
    </table>
  </div>
</details>
