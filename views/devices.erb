<header class="t-page-header">
  <h1 class="t-page-title"><svg class="t-icon" aria-hidden="true"><use href="/tailor/icons.svg#bi-cpu"/></svg>Devices</h1>
  <div class="t-page-actions">
    <div class="t-input-group device-filter" data-size="sm">
      <span class="t-input-addon"><svg class="t-icon" aria-hidden="true"><use href="/tailor/icons.svg#bi-funnel"/></svg></span>
      <input id="device-filter" data-hotkey="/" class="t-input" type="search" placeholder="Filter devices" aria-label="Filter devices">
    </div>
    <span id="device-count" class="t-small t-muted t-nowrap"></span>
  </div>
</header>

<div class="t-card">
  <div id="devices-empty" hidden></div>
  <div id="devices-wrap" class="t-table-wrap" hidden>
    <table class="t-table devices-table" data-variant="data">
      <thead>
        <tr>
          <th class="t-col-icon"></th>
          <th>Device</th>
          <th>ID</th>
          <th>Rule</th>
          <th>Last seen</th>
          <th>Since</th>
          <th class="t-col-icon"></th>
          <th class="t-col-icon"></th>
        </tr>
      </thead>
      <tbody id="devices-body"></tbody>
    </table>
  </div>
</div>

<div id="timeline-card" class="t-card t-section" hidden>
  <div class="t-card-header">
    <h3 class="t-card-title"><svg class="t-icon" aria-hidden="true"><use href="/tailor/icons.svg#bi-bar-chart-steps"/></svg><span id="timeline-title">Timeline</span></h3>
    <span id="timeline-uptime" class="t-small t-muted"></span>
    <span class="t-card-tools">
      <select id="timeline-range" class="t-select range-select" data-size="sm" data-width="auto" aria-label="Timeline range">
        <option value="1h">Last hour</option>
        <option value="6h">Last 6 hours</option>
        <option value="24h" selected>Last 24 hours</option>
        <option value="7d">Last 7 days</option>
      </select>
      <button id="timeline-close" class="t-btn" data-variant="ghost" data-size="sm" data-icon="only" type="button" title="Close" aria-label="Close"><svg class="t-icon" aria-hidden="true"><use href="/tailor/icons.svg#bi-x-lg"/></svg></button>
    </span>
  </div>
  <div class="t-card-body">
    <div id="timeline-empty" hidden></div>
    <div id="timeline-wrap" hidden>
      <div id="timeline-bar" class="uptime-bar"></div>
      <div class="uptime-axis"><span id="timeline-from"></span><span id="timeline-to"></span></div>
      <div class="uptime-legend t-small t-muted">
        <span><span class="t-dot" data-status="running"></span> online</span>
        <span><span class="t-dot" data-status="stopped"></span> offline</span>
        <span><span class="t-dot uptime-unknown"></span> no data</span>
      </div>
    </div>
  </div>
</div>
