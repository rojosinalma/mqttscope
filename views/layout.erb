<% page_title = (defined?(title) && title) || "mqttscope" -%>
<% current = defined?(nav) ? nav : nil -%>
<% tabs = [
     ["explorer", "/",         "bi-diagram-3",    "Explorer"],
     ["stats",    "/stats",    "bi-speedometer2", "Stats"],
     ["devices",  "/devices",  "bi-cpu",          "Devices"],
     ["settings", "/settings", "bi-sliders",      "Settings"]
   ] -%>
<% page_script = tabs.map(&:first).include?(current) ? current : nil -%>
<% charts = %w[explorer stats].include?(current) -%>
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= page_title %></title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <%# tailor head (vendored public/tailor/tailor-head.html, kept current by `tailor sync`) %>
  <%== File.read(File.join(Dir.pwd, "public/tailor/tailor-head.html")) %>
  <link href="/vendor/bootstrap-icons/bootstrap-icons.min.css" rel="stylesheet">
<% if charts -%>
  <link href="https://cdn.jsdelivr.net/npm/uplot@1.6.30/dist/uPlot.min.css" rel="stylesheet">
<% end -%>
  <link href="<%= asset("css/app.css") %>" rel="stylesheet">
</head>
<body>
<div class="t-shell" data-sidebar="none">
  <header class="t-navbar t-shell-nav app-navbar">
    <a class="t-navbar-brand" href="/"><i class="t-icon bi bi-broadcast" aria-hidden="true"></i>mqttscope</a>
    <span id="conn-indicator" class="conn-indicator" title="Broker connection: checking…">
      <span class="t-dot" data-status="muted"></span><span id="conn-label">broker</span>
    </span>
    <ul class="t-navbar-nav">
<% tabs.each do |key, href, icon, label| -%>
      <li><a class="t-navbar-link"<%= ' aria-current="page"' if current == key %> href="<%= href %>"><i class="t-icon bi <%= icon %>" aria-hidden="true"></i><span class="nav-label"><%= label %></span></a></li>
<% end -%>
    </ul>
  </header>

  <main class="t-shell-main t-page main-content<%= " main-fill" if current == "explorer" %>">
    <div id="conn-banner" class="t-alert conn-banner" data-tone="danger" role="alert" hidden>
      <i class="t-icon t-alert-icon bi bi-plug-fill" aria-hidden="true"></i>
      <div class="t-alert-body"><b>Broker disconnected.</b> <span id="conn-banner-detail">Live data is paused; stored history is still available.</span></div>
      <div class="t-alert-actions"><button id="conn-banner-reconnect" class="t-btn" data-size="sm" data-tone="danger" type="button"><i class="t-icon bi bi-arrow-repeat" aria-hidden="true"></i>Reconnect</button></div>
    </div>
<%== yield %>
  </main>

  <footer class="t-footer t-shell-foot">
    <div class="t-footer-end">
      <span class="t-footer-version">mqttscope <%= APP_VERSION %></span>
      <div data-tailor-pickers></div>
    </div>
  </footer>
</div>

<%# Tailor.toast appends .t-toast here %>
<div id="t-toasts" class="t-toasts" aria-live="polite" aria-atomic="false"></div>

<% if charts -%>
<script src="https://cdn.jsdelivr.net/npm/uplot@1.6.30/dist/uPlot.iife.min.js"></script>
<% end -%>
<%# deferred so they run after tailor.js (also deferred, earlier in <head>), in order %>
<script src="<%= asset("js/common.js") %>" defer></script>
<% if page_script -%>
<script src="<%= asset("js/#{page_script}.js") %>" defer></script>
<% end -%>
</body>
</html>
