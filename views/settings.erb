<%
  number = ->(key, label, help = nil, unit: nil, min: 0) { { key: key, label: label, help: help, unit: unit, min: min, kind: "int" } }
  text = ->(key, label, help = nil, placeholder: nil) { { key: key, label: label, help: help, placeholder: placeholder, kind: "text" } }
  panes = [
    ["broker", "hdd-network", "Broker", [
      ["Connection", [
        text.("mqtt_host", "Host", "Hostname or IP of the MQTT broker."),
        number.("mqtt_port", "Port", nil, min: 1),
        text.("mqtt_user", "Username"),
        { key: "mqtt_pass", label: "Password", kind: "secret", help: "Leave the dots untouched to keep the stored password." },
        text.("mqtt_client_id", "Client ID", "Must be unique on the broker."),
        number.("mqtt_keepalive_s", "Keepalive", nil, unit: "s", min: 1)
      ]],
      ["Subscriptions & reconnect", [
        text.("mqtt_subscriptions", "Subscriptions", "Comma-separated filters, e.g. #,$SYS/#", placeholder: "#,$SYS/#"),
        text.("reconnect_backoff_s", "Reconnect backoff", "Comma-separated seconds between attempts; the last one repeats.", placeholder: "2,5,10,30,60")
      ]]
    ]],
    ["storage", "database", "Storage", [
      ["Sampling", [
        { key: "dedup_enabled", label: "Drop consecutive identical payloads", kind: "bool", help: "Repeats bump the stored row's ×N counter instead of adding rows." },
        number.("default_min_interval_ms", "Default min interval", "Store at most one message per topic per interval.", unit: "ms"),
        { key: "sample_rules", label: "Sample rules", kind: "rules", help: "First matching pattern wins; everything else uses the default interval." },
        number.("max_payload_bytes", "Max payload", "Larger payloads are stored truncated.", unit: "bytes", min: 1)
      ]],
      ["Retention", [
        number.("retention_days", "Retention", nil, unit: "days", min: 1),
        { key: "max_db_bytes", label: "Max database size", kind: "gb", unit: "GB", help: "Always enforced; the oldest messages go first." },
        number.("prune_interval_s", "Prune interval", nil, unit: "s", min: 60),
        number.("prune_batch", "Prune batch", "Rows per delete batch.", unit: "rows", min: 1)
      ]]
    ]],
    ["streams", "broadcast-pin", "Streams", [
      ["Live streams (SSE)", [
        number.("sse_max_clients", "Max clients", "Browser tabs that can stream at once.", min: 1),
        number.("sse_idle_timeout_s", "Idle timeout", "Close a stream that had no events this long.", unit: "s", min: 10),
        number.("sse_heartbeat_s", "Heartbeat", nil, unit: "s", min: 1),
        number.("sse_queue_size", "Queue size", "Per-client buffer; overflow drops the oldest events.", unit: "events", min: 10)
      ]],
      ["Explorer", [
        number.("rate_window_s", "Rate window", "Window for msgs/s.", unit: "s", min: 1),
        number.("max_topics", "Max topics in memory", "Least recently seen topics are evicted beyond this.", min: 1),
        number.("history_default_limit", "History page size", nil, unit: "rows", min: 1),
        number.("search_default_limit", "Search result limit", nil, unit: "rows", min: 1)
      ]]
    ]],
    ["presence", "wifi", "Presence", [
      ["Presence rules", [
        { key: "presence_rules", label: "Rules", kind: "rules", help: "A device is online when online_path is truthy in its last payload and it was seen within stale_s. id_segment is the 0-based topic segment holding the device id." }
      ]]
    ]],
    ["publishing", "send", "Publishing", [
      ["Publishing", [
        { key: "publish_enabled", label: "Allow publishing from the explorer", kind: "bool", help: "UI publishes are stored with origin “ui”." }
      ]]
    ]]
  ]
-%>
<header class="t-page-header">
  <h1 class="t-page-title"><svg class="t-icon" aria-hidden="true"><use href="/tailor/icons.svg#bi-sliders"/></svg>Settings</h1>
</header>

<div id="settings-error" hidden></div>

<div class="settings-layout">
  <nav class="t-sidebar settings-sidebar" aria-label="Settings sections">
    <ul>
<% panes.each_with_index do |(id, icon, label, _), i| -%>
      <li><button class="t-sidebar-item"<%= ' aria-current="page"' if i.zero? %> type="button" data-pane="<%= id %>"><svg class="t-icon" aria-hidden="true"><use href="/tailor/icons.svg#bi-<%= icon %>"/></svg><span class="t-sidebar-item-name"><%= label %></span></button></li>
<% end -%>
      <li><button class="t-sidebar-item" type="button" data-pane="appearance"><svg class="t-icon" aria-hidden="true"><use href="/tailor/icons.svg#bi-palette"/></svg><span class="t-sidebar-item-name">Appearance</span></button></li>
    </ul>
  </nav>

  <div class="settings-content">
<% panes.each_with_index do |(id, _icon, label, groups), i| -%>
    <form class="settings-pane"<%= ' hidden' unless i.zero? %> data-pane="<%= id %>" autocomplete="off" novalidate>
<% groups.each do |heading, fields| -%>
      <section class="t-section">
      <h2 class="t-section-title"><%= heading %></h2>
      <div class="t-stack settings-group">
<% fields.each do |f| -%>
<% fid = "set-#{f[:key]}" -%>
<% case f[:kind] -%>
<% when "bool" -%>
        <div class="t-field">
          <label class="t-check" data-variant="switch"><input class="t-check-input" type="checkbox" role="switch" id="<%= fid %>" data-key="<%= f[:key] %>" data-kind="bool"><span class="t-check-label"><%= f[:label] %></span></label>
<% if f[:help] -%>
          <p class="t-hint"><%= f[:help] %></p>
<% end -%>
        </div>
<% when "rules" -%>
        <div class="t-field">
          <span class="t-label"><%= f[:label] %></span>
          <div class="rules-editor" id="<%= fid %>" data-key="<%= f[:key] %>" data-kind="rules"></div>
<% if f[:help] -%>
          <p class="t-hint"><%= f[:help] %></p>
<% end -%>
        </div>
<% else -%>
        <div class="t-field">
          <label class="t-label" for="<%= fid %>"><%= f[:label] %></label>
          <div class="t-input-group">
<% if f[:kind] == "secret" -%>
            <input class="t-input" type="password" id="<%= fid %>" data-key="<%= f[:key] %>" data-kind="secret" autocomplete="new-password">
            <button class="t-btn secret-toggle" type="button" data-target="<%= fid %>" title="Show / hide" aria-label="Show / hide"><svg class="t-icon" aria-hidden="true"><use href="/tailor/icons.svg#bi-eye"/></svg></button>
<% elsif f[:kind] == "gb" -%>
            <input class="t-input" type="number" min="0.1" step="0.1" id="<%= fid %>" data-key="<%= f[:key] %>" data-kind="gb">
<% elsif f[:kind] == "int" -%>
            <input class="t-input" type="number" step="1" min="<%= f[:min] %>" id="<%= fid %>" data-key="<%= f[:key] %>" data-kind="int">
<% else -%>
            <input class="t-input t-mono" type="text" id="<%= fid %>" data-key="<%= f[:key] %>" data-kind="text"<% if f[:placeholder] %> placeholder="<%= f[:placeholder] %>"<% end %>>
<% end -%>
<% if f[:unit] -%>
            <span class="t-input-addon"><%= f[:unit] %></span>
<% end -%>
          </div>
<% if f[:help] -%>
          <p class="t-hint"><%= f[:help] %></p>
<% end -%>
        </div>
<% end -%>
<% end -%>
      </div>
      </section>
<% end -%>
<% if id == "streams" -%>
      <section class="t-section">
      <h2 class="t-section-title">This browser</h2>
      <div class="t-stack settings-group">
        <div class="t-field">
          <label class="t-label" for="local-timeline-cap">Timeline rows kept live</label>
          <div class="t-input-group">
            <input class="t-input" type="number" min="50" max="5000" step="50" id="local-timeline-cap">
            <span class="t-input-addon">rows</span>
          </div>
          <p class="t-hint">Stored in this browser only; oldest rows drop off the explorer timeline beyond this.</p>
        </div>
      </div>
      </section>
<% end -%>
      <div class="t-toolbar settings-actions">
        <button class="t-btn" data-variant="primary" type="submit"><svg class="t-icon" aria-hidden="true"><use href="/tailor/icons.svg#bi-check-lg"/></svg>Save <%= label.downcase %></button>
<% if id == "broker" -%>
        <button class="t-btn" type="button" id="reconnect-btn"><svg class="t-icon" aria-hidden="true"><use href="/tailor/icons.svg#bi-arrow-repeat"/></svg>Reconnect</button>
<% end -%>
      </div>
    </form>
<% end -%>
    <div class="settings-pane" hidden data-pane="appearance">
      <section class="t-section">
      <h2 class="t-section-title">Appearance</h2>
      <div class="t-settings">
        <div class="t-setting">
          <div class="t-setting-label"><span>Appearance</span>
            <span class="t-help" data-tone="info"><button class="t-help-btn" type="button" aria-expanded="false" aria-label="About appearance">i</button><div class="t-help-box" hidden><p>Skin and colour palette of this UI. Light/dark is the sun/moon toggle in the footer.</p></div></span></div>
          <div class="t-setting-control"><div data-tailor-pickers="skin palette"></div></div>
        </div>
      </div>
      </section>
    </div>
  </div>
</div>
